// Home page: what Chronoclip is doing right now, the big Save button and this session's clips.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, ButtonKind, Card, Hint, Icon, Keycap, ProgressBar } from "components.slint";

/// One clip saved this session.
export struct ClipRow {
    // File name, e.g. "ELDEN RING_2026-11-27_21-04-33.mp4".
    name: string,
    // "21:04 · 0:10 · 26 MB": when it was saved, length, size.
    detail: string,
}

/// Height of one clip row (fixed, so the card can size itself to its rows).
global ClipList {
    out property <length> row-height: 60px;
    out property <length> header-height: 40px;
}

component ClipItem {
    in property <ClipRow> item;
    in property <bool> newest;
    callback play();
    callback show();

    height: ClipList.row-height;

    HorizontalLayout {
        padding-left: Theme.space-l;
        padding-right: Theme.space-m;
        spacing: Theme.space-m;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: Theme.radius;
                background: root.newest ? Theme.accent-soft : Theme.surface-raised;
                Icon {
                    source: @image-url("icons/lucide/film.svg");
                    color: root.newest ? Theme.accent : Theme.text-muted;
                    size: 18px;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.item.detail;
                color: Theme.text-muted;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Button {
                text: "Play";
                has-icon: true;
                icon: @image-url("icons/lucide/play.svg");
                height-hint: 32px;
                font-size: Theme.font-small;
                clicked => {
                    root.play();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Button {
                text: "Show in folder";
                kind: ButtonKind.ghost;
                has-icon: true;
                icon: @image-url("icons/lucide/folder-open.svg");
                height-hint: 32px;
                font-size: Theme.font-small;
                clicked => {
                    root.show();
                }
            }
        }
    }
}

export enum RecState { waiting, recording, error }

/// "● RECORDING" pill. The dot pulses while recording and `pulse` is on (window visible).
component StatusBadge inherits Rectangle {
    in property <RecState> state;
    in property <bool> pulse;

    property <color> tint: root.state == RecState.recording ? Theme.record
        : root.state == RecState.error ? Theme.warning : Theme.text-faint;
    // animation-tick() redraws continuously, so only use it while it can be seen.
    property <duration> tick: root.pulse && root.state == RecState.recording ? animation-tick() : 0ms;

    height: 26px;
    width: row.preferred-width;
    border-radius: self.height / 2;
    background: root.tint.with-alpha(0.15);

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: root.tint;
                opacity: root.tick == 0ms ? 1 : 0.55 + 0.45 * sin(root.tick / 1.4s * 360deg);
            }
        }

        Text {
            text: root.state == RecState.recording ? "RECORDING" : root.state == RecState.error ? "PROBLEM" : "WAITING";
            color: root.tint;
            font-size: Theme.font-small;
            font-weight: 700;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
    }
}

/// The big accent button with the hotkey on it.
component SaveButton {
    in property <string> hotkey;
    in property <bool> saving;
    callback clicked();

    min-height: 60px;
    accessible-role: button;
    accessible-label: root.saving ? "Saving replay" : "Save replay";
    accessible-action-default => {
        root.clicked();
    }

    Rectangle {
        border-radius: Theme.radius-large;
        background: root.saving ? Theme.accent-pressed : touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent;
        animate background { duration: 120ms; }
        drop-shadow-blur: 16px;
        drop-shadow-color: touch.has-hover ? #5865f255 : #5865f230;
        drop-shadow-offset-y: 4px;
    }

    HorizontalLayout {
        alignment: center;
        spacing: Theme.space-m;
        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("icons/lucide/film.svg");
                color: Theme.on-accent;
                size: 22px;
            }
        }

        Text {
            text: root.saving ? "Saving…" : "Save replay";
            color: Theme.on-accent;
            font-size: 18px;
            font-weight: 700;
            vertical-alignment: center;
        }

        if root.hotkey != "": VerticalLayout {
            alignment: center;
            Keycap {
                text: root.hotkey;
                ink: Theme.on-accent;
            }
        }
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Theme.radius-large + 3px;
        border-width: 2px;
        border-color: focus.has-focus && focus.keyboard ? Theme.focus-ring : transparent;
    }

    touch := TouchArea {
        enabled: !root.saving;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }

    // Keyboard: Tab to it, Enter or Space saves.
    focus := FocusScope {
        focus-on-click: false;
        in-out property <bool> keyboard: false;
        focus-gained(reason) => {
            self.keyboard = reason == FocusReason.tab-navigation;
        }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") && !root.saving {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

export component HomePage {
    // Recording state and what is being recorded.
    in property <RecState> state;
    in property <string> title;
    in property <string> detail;
    // Replay buffer: fill (0..1), "7:12 of 10:00", "1.4 GB".
    in property <float> buffer-fraction;
    in property <string> buffer-label;
    in property <string> buffer-size;
    in property <string> hotkey;
    // Animate the record dot (window visible).
    in property <bool> pulse;
    // Saving and its result.
    in property <bool> saving;
    in property <string> save-text;
    in property <bool> save-is-error;
    // An error to show on Home, e.g. a picked window that can't be recorded.
    in property <string> notice;
    // Clips saved this session, newest first (at most 10).
    in property <[ClipRow]> clips;
    callback save-replay();
    callback choose-window();
    // "Record this game?" ("" = nothing to ask).
    in property <string> suggestion-name;
    in property <string> suggestion-detail;
    callback accept-suggestion();
    callback dismiss-suggestion();
    callback play-clip(int);
    callback show-clip(int);

    // Everything above the clips keeps its size; the clips card takes what's left (no more
    // than its rows need) and only its list scrolls.
    VerticalLayout {
        padding: Theme.space-xl;
        spacing: Theme.space-l;

        // Status, questions and Save replay: always their natural height.
        VerticalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-l;

        Card {
            VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-m;

                HorizontalLayout {
                    StatusBadge {
                        state: root.state;
                        pulse: root.pulse;
                    }

                    Rectangle { }

                    Button {
                        text: root.state == RecState.recording ? "Choose window" : "Game not found? Choose window";
                        kind: ButtonKind.ghost;
                        has-icon: true;
                        icon: @image-url("icons/lucide/app-window.svg");
                        height-hint: 30px;
                        font-size: Theme.font-small;
                        clicked => {
                            root.choose-window();
                        }
                    }
                }

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-hero;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                Text {
                    text: root.detail;
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    padding-top: Theme.space-m;
                    spacing: Theme.space-s;
                    HorizontalLayout {
                        Text {
                            text: "REPLAY BUFFER";
                            color: Theme.text-faint;
                            font-size: Theme.font-small;
                            font-weight: 700;
                            letter-spacing: 1px;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: root.buffer-size == "" ? root.buffer-label : root.buffer-label + "  ·  " + root.buffer-size;
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            font-weight: 600;
                        }
                    }

                    ProgressBar {
                        value: root.buffer-fraction;
                        fill: root.state == RecState.recording ? Theme.accent : Theme.border-strong;
                    }
                }
            }
        }

        if root.suggestion-name != "": Rectangle {
            border-radius: Theme.radius-large;
            background: Theme.accent-soft;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.5);
            HorizontalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-l;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("icons/lucide/gamepad-2.svg");
                        color: Theme.accent;
                        size: 22px;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: "Record " + root.suggestion-name + "?";
                        color: Theme.text;
                        font-size: Theme.font-body;
                        font-weight: 700;
                        overflow: elide;
                    }

                    Text {
                        text: "It looks like a game" + (root.suggestion-detail != "" ? " (" + root.suggestion-detail + ")" : "") + ", but Chronoclip doesn't know it yet.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Record";
                        kind: ButtonKind.primary;
                        clicked => {
                            root.accept-suggestion();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Not this one";
                        kind: ButtonKind.ghost;
                        clicked => {
                            root.dismiss-suggestion();
                        }
                    }
                }
            }
        }

        if root.notice != "": Rectangle {
            border-radius: Theme.radius;
            background: Theme.danger.with-alpha(0.12);
            border-width: 1px;
            border-color: Theme.danger.with-alpha(0.4);
            HorizontalLayout {
                padding: Theme.space-m;
                Text {
                    text: root.notice;
                    color: Theme.text;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
            }
        }

        SaveButton {
            hotkey: root.hotkey;
            saving: root.saving;
            clicked => {
                root.save-replay();
            }
        }

        // Success shows in the last clip card; here only errors.
        if root.save-is-error && root.save-text != "": Text {
            text: root.save-text;
            color: root.save-is-error ? Theme.danger : Theme.text-muted;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        }

        if root.clips.length == 0: Card {
            HorizontalLayout {
                padding: Theme.space-l;
                spacing: Theme.space-l;

                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: Theme.radius;
                    background: Theme.accent-soft;
                    Icon {
                        source: @image-url("icons/lucide/film.svg");
                        color: Theme.accent;
                        size: 22px;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: "NO CLIPS YET";
                        color: Theme.text-faint;
                        font-size: Theme.font-small;
                        font-weight: 700;
                        letter-spacing: 1px;
                    }

                    Text {
                        text: "Press " + (root.hotkey == "" ? "Save replay" : root.hotkey) + " in game to save the last minutes.";
                        color: Theme.text;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                }
            }
        }

        if root.clips.length > 0: Card {
            // As tall as the rows need, but not taller than the space left (then the list
            // scrolls); at least one row stays visible.
            property <length> rows: root.clips.length * (ClipList.row-height + 1px);
            min-height: ClipList.header-height + ClipList.row-height + Theme.space-s;
            max-height: ClipList.header-height + self.rows + Theme.space-s;
            // Takes the free height before the filler below does.
            vertical-stretch: 100;

            VerticalLayout {
                padding-bottom: Theme.space-s;
                HorizontalLayout {
                    height: ClipList.header-height;
                    padding-left: Theme.space-l;
                    padding-right: Theme.space-l;
                    Text {
                        text: "CLIPS THIS SESSION";
                        color: Theme.text-faint;
                        font-size: Theme.font-small;
                        font-weight: 700;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: root.clips.length == 1 ? "1 clip" : root.clips.length + " clips";
                        color: Theme.text-faint;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    // The rows have a fixed height: tell the scroll area how tall they are (it
                    // doesn't work it out from the repeated rows).
                    content-height: root.clips.length * (ClipList.row-height + 1px);
                    content-width: self.visible-width;
                    VerticalLayout {
                        alignment: start;
                        for clip[index] in root.clips: VerticalLayout {
                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                                opacity: 0.6;
                            }
                            ClipItem {
                                item: clip;
                                newest: index == 0;
                                play => {
                                    root.play-clip(index);
                                }
                                show => {
                                    root.show-clip(index);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Fills the rest when the clips need less room, so nothing above moves.
        Rectangle {
            vertical-stretch: 1;
        }
    }
}
