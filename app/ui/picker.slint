// Window picker: a dialog over the window listing the open windows; picking one adds it to
// the games and records it.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, ButtonKind, Card, Icon, IconButton } from "components.slint";

/// One open window in the picker.
export struct WindowRow {
    title: string,
    // Program, e.g. "eldenring.exe", or "In your games: World of Warcraft".
    detail: string,
}

component WindowItem {
    in property <WindowRow> item;
    callback pick();

    min-height: 56px;

    Rectangle {
        border-radius: Theme.radius;
        background: touch.has-hover ? Theme.surface-hover : transparent;
        animate background { duration: 100ms; }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.pick();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-s;
        spacing: Theme.space-m;
        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("icons/lucide/app-window.svg");
                color: Theme.text-muted;
                size: 18px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.item.title;
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.item.detail;
                color: Theme.text-faint;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Button {
                text: "Record";
                height-hint: 30px;
                font-size: Theme.font-small;
                clicked => {
                    root.pick();
                }
            }
        }
    }
}

export component WindowPicker inherits Rectangle {
    in property <[WindowRow]> windows;
    callback pick(int);
    callback refresh();
    callback close();

    background: #000000a0;
    forward-focus: keys;

    // Clicks outside the dialog close it.
    TouchArea {
        clicked => {
            root.close();
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            reject
        }
    }

    dialog := Card {
        width: min(600px, root.width - 2 * Theme.space-xl);
        height: min(520px, root.height - 2 * Theme.space-xl);
        background: Theme.surface-raised;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;

        // Swallow clicks on the dialog itself.
        TouchArea { }

        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-m;

            HorizontalLayout {
                spacing: Theme.space-m;
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: "Choose the game window";
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: 700;
                    }

                    Text {
                        text: "It's added to your games (Games tab), so Chronoclip records it by itself next time.";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                }

                IconButton {
                    icon: @image-url("icons/lucide/x.svg");
                    label: "Close";
                    clicked => {
                        root.close();
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                border-radius: Theme.radius;
                background: Theme.surface;

                if root.windows.length == 0: Text {
                    text: "No windows found. Start the game, then press Refresh.";
                    color: Theme.text-faint;
                    font-size: Theme.font-body;
                }

                ScrollView {
                    VerticalLayout {
                        padding: Theme.space-xs;
                        alignment: start;
                        for row[index] in root.windows: WindowItem {
                            item: row;
                            pick => {
                                root.pick(index);
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-s;
                alignment: end;
                Button {
                    text: "Refresh";
                    kind: ButtonKind.ghost;
                    has-icon: true;
                    icon: @image-url("icons/lucide/rotate-ccw.svg");
                    clicked => {
                        root.refresh();
                    }
                }

                Button {
                    text: "Cancel";
                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }
}
