export component Tray inherits SystemTrayIcon {
    icon: @image-url("icons/chronoclip-64.png");
    in property <string> status: "Chronoclip";
    tooltip: root.status;
    title: "Chronoclip";

    callback open();
    callback save-replay();
    callback quit();

    clicked => {
        root.open();
    }

    Menu {
        MenuItem {
            title: "Open Chronoclip";
            activated => {
                root.open();
            }
        }

        MenuItem {
            title: "Save replay";
            activated => {
                root.save-replay();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: "Quit";
            activated => {
                root.quit();
            }
        }
    }
}
