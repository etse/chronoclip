/// What the tray icon shows: red dot while recording, grey while waiting for the game,
/// amber when recording failed.
export enum TrayState { waiting, recording, error }

export component Tray inherits SystemTrayIcon {
    in property <TrayState> state: TrayState.waiting;
    icon: root.state == TrayState.recording ? @image-url("icons/chronoclip-64.png")
        : root.state == TrayState.error ? @image-url("icons/chronoclip-64-error.png")
        : @image-url("icons/chronoclip-64-idle.png");
    in property <string> status: "Chronoclip";
    tooltip: root.status;
    title: "Chronoclip";

    callback open();
    callback save-replay();
    callback quit();

    clicked => {
        root.open();
    }

    Menu {
        MenuItem {
            title: "Open Chronoclip";
            activated => {
                root.open();
            }
        }

        MenuItem {
            title: "Save replay";
            activated => {
                root.save-replay();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: "Quit";
            activated => {
                root.quit();
            }
        }
    }
}
