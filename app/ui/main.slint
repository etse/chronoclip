import "fonts/Inter-Regular.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SettingsPage } from "settings.slint";
import { GameRow, GamesPage } from "games.slint";
import { WindowPicker, WindowRow } from "picker.slint";
import { AboutPage } from "about.slint";
import { TitleBar } from "titlebar.slint";
import { HomePage, RecState } from "home.slint";

export { Tray, TrayState } from "tray.slint";
export { RecState } from "home.slint";
export { GameRow } from "games.slint";
export { WindowRow } from "picker.slint";

/// Window edge or corner the user drags to resize the frameless window.
export enum ResizeEdge { north, south, east, west, north-east, north-west, south-east, south-west }

export component MainWindow inherits Window {
    title: "Chronoclip";
    icon: @image-url("icons/chronoclip-256.png");
    no-frame: root.custom-title-bar;
    background: Theme.background;
    default-font-family: Theme.font;
    default-font-size: Theme.font-body;
    preferred-width: 920px;
    preferred-height: 640px;
    min-width: 720px;
    min-height: 540px;

    // Frameless window with our own title bar (off: the system's title bar).
    in-out property <bool> custom-title-bar: true;
    in-out property <int> current-tab: 0;

    // Home page (set from Rust)
    in property <RecState> rec-state: RecState.waiting;
    in property <string> rec-title: "Starting…";
    in property <string> rec-detail;
    in property <float> buffer-fraction;
    in property <string> buffer-label;
    in property <string> buffer-size;
    in property <bool> has-last-clip;
    in property <string> last-clip-name;
    in property <string> last-clip-detail;
    callback play-last-clip();
    callback show-last-clip();
    // Games (Settings) and the window picker.
    in property <[GameRow]> games;
    in property <[GameRow]> installed-games;
    in property <[GameRow]> ignored-games;
    in property <[GameRow]> builtin-games;
    in property <[WindowRow]> open-windows;
    in-out property <bool> picker-open: false;
    callback choose-window();
    callback pick-window(int);
    callback game-action(int, int);
    // Search texts on the Games tab and in the window picker (Rust filters).
    in-out property <string> games-query;
    in-out property <string> picker-query;
    callback search-games(string);
    callback search-windows(string);
    // A tab was opened (the Games tab looks for installed games again).
    callback tab-opened(int);
    // "Record this game?": a window that looks like a game but is in no list ("" = none).
    in property <string> suggestion-name;
    in property <string> suggestion-detail;
    callback accept-suggestion();
    callback dismiss-suggestion();
    // A game just picked can't be recorded: Rust removes it again.
    callback game-failed(string, string);
    callback close-window();
    callback start-resize(ResizeEdge);
    callback open-url(string);
    callback hotkey-captured(string, bool, bool, bool, bool);

    // Status (set from Rust)
    in property <string> version;
    in property <bool> recording: false;
    in property <string> status-text: "Not recording";
    in property <string> message;
    in property <bool> message-is-error: false;
    in property <bool> saving: false;
    // Result of the last save (or why it failed).
    in property <string> save-text;
    in property <bool> save-is-error: false;
    // Why the hotkey could not be registered; empty when it works.
    in property <string> hotkey-error;
    in property <[string]> fps-options;
    in property <[string]> encoder-options;
    in property <[string]> audio-options;

    // Editable settings (read by Rust on apply)
    in-out property <string> hotkey;
    in-out property <float> buffer-minutes: 10;
    in-out property <string> fps;
    in-out property <string> encoder;
    in-out property <string> audio;
    in-out property <bool> microphone;
    in-out property <bool> save-sound: true;
    // Not part of the settings file: mirrors whether the autostart entry exists.
    in-out property <bool> autostart: false;
    in-out property <string> buffer-dir;
    in-out property <string> output-dir;

    pure callback estimate-disk(int, string) -> string;
    pure callback buffer-dir-warning(string) -> string;
    callback apply();
    callback reset-defaults();
    callback open-folder(string);
    callback save-replay();
    callback autostart-toggled(bool);

    property <int> minutes: Math.round(root.buffer-minutes);
    property <string> dir-warning: root.buffer-dir-warning(root.buffer-dir);

    init => {
        // The stock ScrollView (Settings, About) follows the dark theme.
        Palette.color-scheme = ColorScheme.dark;
    }

    VerticalLayout {
        TitleBar {
            current-tab: root.current-tab;
            custom: root.custom-title-bar;
            maximized: root.maximized;
            select-tab(index) => {
                root.current-tab = index;
                root.tab-opened(index);
            }
            minimize => {
                root.minimized = true;
            }
            toggle-maximize => {
                root.maximized = !root.maximized;
            }
            close => {
                root.close-window();
            }
        }

        if root.current-tab == 0: HomePage {
            state: root.rec-state;
            title: root.rec-title;
            detail: root.rec-detail;
            buffer-fraction: root.buffer-fraction;
            buffer-label: root.buffer-label;
            buffer-size: root.buffer-size;
            hotkey: root.hotkey-error == "" ? root.hotkey : "";
            pulse: !root.minimized;
            saving: root.saving;
            save-text: root.save-text;
            save-is-error: root.save-is-error;
            notice: root.message-is-error ? root.message : "";
            has-last-clip: root.has-last-clip;
            last-clip-name: root.last-clip-name;
            last-clip-detail: root.last-clip-detail;
            save-replay => {
                root.save-replay();
            }
            choose-window => {
                root.choose-window();
            }
            suggestion-name: root.suggestion-name;
            suggestion-detail: root.suggestion-detail;
            accept-suggestion => {
                root.accept-suggestion();
            }
            dismiss-suggestion => {
                root.dismiss-suggestion();
            }
            play-last-clip => {
                root.play-last-clip();
            }
            show-last-clip => {
                root.show-last-clip();
            }
        }

        if root.current-tab == 1: GamesPage {
            games: root.games;
            installed-games: root.installed-games;
            ignored-games: root.ignored-games;
            builtin-games: root.builtin-games;
            message: root.message;
            message-is-error: root.message-is-error;
            add-game => {
                root.choose-window();
            }
            game-action(section, index) => {
                root.game-action(section, index);
            }
            query <=> root.games-query;
            search(text) => {
                root.search-games(text);
            }
        }

        if root.current-tab == 2: SettingsPage {
            hotkey <=> root.hotkey;
            buffer-minutes <=> root.buffer-minutes;
            fps <=> root.fps;
            encoder <=> root.encoder;
            audio <=> root.audio;
            microphone <=> root.microphone;
            save-sound <=> root.save-sound;
            autostart <=> root.autostart;
            custom-title-bar <=> root.custom-title-bar;
            buffer-dir <=> root.buffer-dir;
            output-dir <=> root.output-dir;
            fps-options: root.fps-options;
            encoder-options: root.encoder-options;
            audio-options: root.audio-options;
            hotkey-error: root.hotkey-error;
            message: root.message;
            message-is-error: root.message-is-error;
            disk-estimate: root.estimate-disk(root.minutes, root.fps);
            dir-warning: root.dir-warning;
            apply => {
                root.apply();
            }
            reset-defaults => {
                root.reset-defaults();
            }
            open-folder(dir) => {
                root.open-folder(dir);
            }
            autostart-toggled(on) => {
                root.autostart-toggled(on);
            }
            hotkey-captured(text, ctrl, alt, shift, meta) => {
                root.hotkey-captured(text, ctrl, alt, shift, meta);
            }
        }

        if root.current-tab == 3: AboutPage {
            version: root.version;
            open-url(url) => {
                root.open-url(url);
            }
        }
    }

    if root.picker-open: WindowPicker {
        y: root.custom-title-bar ? Theme.title-bar-height : 0;
        height: root.height - self.y;
        windows: root.open-windows;
        query <=> root.picker-query;
        search(text) => {
            root.search-windows(text);
        }
        init => {
            self.focus();
        }
        pick(index) => {
            root.pick-window(index);
        }
        refresh => {
            root.choose-window();
        }
        close => {
            root.picker-open = false;
        }
    }

    // Resize handles for the frameless window (the window manager does the resizing).
    if root.custom-title-bar && !root.maximized: Rectangle {
        property <length> edge: 5px;
        property <length> corner: 12px;
        TouchArea {
            x: corner; y: 0; width: parent.width - 2 * corner; height: edge;
            mouse-cursor: MouseCursor.n-resize;
            pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.start-resize(ResizeEdge.north); } }
        }
        TouchArea {
            x: corner; y: parent.height - edge; width: parent.width - 2 * corner; height: edge;
            mouse-cursor: MouseCursor.s-resize;
            pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.start-resize(ResizeEdge.south); } }
        }
        TouchArea {
            x: 0; y: corner; width: edge; height: parent.height - 2 * corner;
            mouse-cursor: MouseCursor.w-resize;
            pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.start-resize(ResizeEdge.west); } }
        }
        TouchArea {
            x: parent.width - edge; y: corner; width: edge; height: parent.height - 2 * corner;
            mouse-cursor: MouseCursor.e-resize;
            pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.start-resize(ResizeEdge.east); } }
        }
        TouchArea {
            x: 0; y: 0; width: corner; height: corner;
            mouse-cursor: MouseCursor.nw-resize;
            pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.start-resize(ResizeEdge.north-west); } }
        }
        TouchArea {
            x: parent.width - corner; y: 0; width: corner; height: corner;
            mouse-cursor: MouseCursor.ne-resize;
            pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.start-resize(ResizeEdge.north-east); } }
        }
        TouchArea {
            x: 0; y: parent.height - corner; width: corner; height: corner;
            mouse-cursor: MouseCursor.sw-resize;
            pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.start-resize(ResizeEdge.south-west); } }
        }
        TouchArea {
            x: parent.width - corner; y: parent.height - corner; width: corner; height: corner;
            mouse-cursor: MouseCursor.se-resize;
            pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.start-resize(ResizeEdge.south-east); } }
        }
    }
}
